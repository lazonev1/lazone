{
  "name": "lazone",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for LaZone project",
  "scripts": {
    "audit:prod": "node scripts/auditProduction.mjs",
    "dev:mobile": "pnpm --filter ./apps/mobile start",
    "eas:login": "node scripts/runEas.mjs login",
    "prebuild:mobile": "pnpm --filter ./apps/mobile exec expo prebuild --clean",
    "build:simulator": "node scripts/runEas.mjs build --profile simulator --platform all --non-interactive",
    "build:simulator:ios": "node scripts/runEas.mjs build --profile simulator --platform ios --non-interactive",
    "build:simulator:android": "node scripts/runEas.mjs build --profile simulator --platform android --non-interactive",
    "build:android": "node scripts/runEas.mjs build --profile development --platform android",
    "build:ios": "node scripts/runEas.mjs build --profile development --platform ios",
    "build:mobile:dev": "node scripts/runEas.mjs build --profile development --platform all",
    "build:mobile:prod": "node scripts/runEas.mjs build --profile production --platform all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {},
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
