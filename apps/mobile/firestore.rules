rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBookingParticipant(booking) {
      return isAuthenticated()
        && (request.auth.uid == booking.requesterId || request.auth.uid == booking.providerId);
    }

    function hasNewLinkedBookingStatusEvent(bookingId) {
      return request.resource.data.latestTransitionId is string
        && (!resource.data.keys().hasAll(['latestTransitionId'])
          || request.resource.data.latestTransitionId != resource.data.latestTransitionId)
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId)/events/$(request.resource.data.latestTransitionId));
    }

    function hasPublishedServices(providerData) {
      return providerData.keys().hasAll(['services'])
        && providerData.services is list
        && providerData.services.size() > 0
        && providerData.services[0].keys().hasAll(['name'])
        && providerData.services[0].name is string
        && providerData.services[0].name.size() > 0;
    }

    function isRatingAggregateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'averageRating', 'reviewCount', 'updatedAt'
        ])
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0;
    }

    function isPublicIdentity(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'avatar', 'updatedAt'])
        && data.keys().hasAll(['firstName', 'lastName'])
        && data.firstName is string
        && data.lastName is string
        && data.firstName.size() <= 80
        && data.lastName.size() <= 80
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048));
    }

    function isPublicProvider(data) {
      return data.keys().hasOnly([
        'firstName', 'lastName', 'avatar', 'businessName', 'profession',
        'categoryName', 'bio', 'remoteService', 'services', 'reviews',
        'averageRating', 'reviewCount', 'coverImage', 'portfolio',
        'pricing', 'location', 'createdAt', 'updatedAt', 'publicSchemaVersion'
      ])
        && data.publicSchemaVersion == 1
        && (!data.keys().hasAny(['location']) || (
          data.location is map
          && data.location.keys().hasOnly(['country', 'city', 'coordinates'])
          && data.location.country is string
          && data.location.city is string
          && (!data.location.keys().hasAny(['coordinates']) || (
            data.location.coordinates is map
            && data.location.coordinates.keys().hasOnly(['latitude', 'longitude'])
            && data.location.coordinates.latitude is number
            && data.location.coordinates.longitude is number
          ))
        ));
    }

    function isValidAccountCreate(data) {
      return data.keys().hasOnly([
          'firstName', 'lastName', 'phoneNumber', 'dob', 'role', 'avatar',
          'verified', 'subscriptionType', 'bookmarked', 'location',
          'notificationTokens', 'preferences', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'firstName', 'lastName', 'phoneNumber', 'role', 'verified',
          'subscriptionType', 'bookmarked', 'createdAt', 'updatedAt'
        ])
        && data.firstName is string
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() <= 80
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 32
        && data.role == 'requester'
        && data.verified == false
        && data.subscriptionType == 'free'
        && data.bookmarked is list
        && data.bookmarked.size() <= 500
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['dob']) || data.dob is timestamp)
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048))
        && (!data.keys().hasAny(['location']) || data.location is map)
        && (!data.keys().hasAny(['notificationTokens']) || (
          data.notificationTokens is list && data.notificationTokens.size() <= 20
        ))
        && (!data.keys().hasAny(['preferences']) || data.preferences is map);
    }

    function hasValidEditableAccountFields(data) {
      return (!data.keys().hasAny(['firstName']) || (data.firstName is string && data.firstName.size() <= 80))
        && (!data.keys().hasAny(['lastName']) || (data.lastName is string && data.lastName.size() <= 80))
        && (!data.keys().hasAny(['phoneNumber']) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!data.keys().hasAny(['dob']) || data.dob is timestamp)
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048))
        && (!data.keys().hasAny(['bookmarked']) || (
          data.bookmarked is list && data.bookmarked.size() <= 500
        ))
        && (!data.keys().hasAny(['location']) || data.location is map)
        && (!data.keys().hasAny(['notificationTokens']) || (
          data.notificationTokens is list && data.notificationTokens.size() <= 20
        ))
        && (!data.keys().hasAny(['preferences']) || data.preferences is map);
    }

    function isSelfServiceAccountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phoneNumber', 'dob', 'avatar', 'bookmarked',
          'location', 'notificationTokens', 'preferences', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasValidEditableAccountFields(request.resource.data);
    }

    function isProviderRolePromotion(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && resource.data.role == 'requester'
        && request.resource.data.role == 'both'
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/providers/$(userId))
        && getAfter(/databases/$(database)/documents/providers/$(userId)).data.publicSchemaVersion == 1
        && hasPublishedServices(getAfter(/databases/$(database)/documents/providers/$(userId)).data);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAccountCreate(request.resource.data);
      allow update: if isOwner(userId)
        && (isSelfServiceAccountUpdate() || isProviderRolePromotion(userId));
      // Account deletion needs coordinated Auth/data cleanup (A03), not a
      // client-side document delete that leaves bookings and messages orphaned.
      allow delete: if false;
    }

    // Minimal identity used by chat and reviews. A caller may fetch a known
    // identity (for example, the author referenced by a public review), but
    // requesters are not a browsable directory.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner(userId) && isPublicIdentity(request.resource.data);
      allow delete: if false;
    }

    // TODO(security): restrict updates to isOwner(providerId) once provider
    // ratings are aggregated by trusted backend code. The current review flow
    // recalculates rating fields on the reviewer's device, which needs this
    // temporary development exception.
    match /providers/{providerId} {
      // Owners may inspect their own record, including checking for its absence
      // before enrollment. Other readers and list queries see migrated profiles.
      allow get: if isOwner(providerId) || resource.data.publicSchemaVersion == 1;
      allow list: if resource.data.publicSchemaVersion == 1;
      allow create: if isOwner(providerId) && hasPublishedServices(request.resource.data)
        && isPublicProvider(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(providerId))
        && getAfter(/databases/$(database)/documents/users/$(providerId)).data.role in ['provider', 'both'];
      allow delete: if isOwner(providerId);
      allow update: if isAuthenticated()
        && hasPublishedServices(request.resource.data)
        && isPublicProvider(request.resource.data)
        && (isOwner(providerId) || isRatingAggregateUpdate());
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isBookingParticipant(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() > 0
        && request.resource.data.checklistTotal == request.resource.data.checklist.size()
        && request.resource.data.checklistCompletedCount == 0
        && request.resource.data.checklistProgress is map
        && exists(/databases/$(database)/documents/providers/$(request.resource.data.providerId))
        && hasPublishedServices(get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data);
      allow update: if isBookingParticipant(resource.data)
        && (
          (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'serviceId', 'serviceName', 'bookingDate', 'price', 'notes', 'checklist', 'checklistTotal', 'checklistCompletedCount', 'checklistProgress', 'updatedAt'
            ])
            && request.resource.data.checklist is list
            && request.resource.data.checklist.size() > 0
            && request.resource.data.checklistTotal == request.resource.data.checklist.size()
            && request.resource.data.checklistCompletedCount == 0
            && request.resource.data.checklistProgress is map
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'in_progress'
            && request.resource.data.status == resource.data.status
            && request.resource.data.keys().hasAll(['checklistProgress', 'checklistCompletedCount'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklistProgress', 'checklistCompletedCount', 'updatedAt'])
            && request.resource.data.checklistProgress is map
            && request.resource.data.checklistCompletedCount >= 0
            && request.resource.data.checklistCompletedCount <= resource.data.checklistTotal
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['confirmed', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'in_progress'
            && request.resource.data.status == 'awaiting_confirmation'
            && request.resource.data.keys().hasAll(['requesterChangeRequest'])
            && request.resource.data.requesterChangeRequest == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requesterChangeRequest', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'awaiting_confirmation'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'awaiting_confirmation'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasAll(['requesterChangeRequest'])
            && request.resource.data.requesterChangeRequest is string
            && request.resource.data.requesterChangeRequest.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requesterChangeRequest', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
        );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isBookingParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
        allow create: if isBookingParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
          && request.resource.data.keys().hasOnly(['fromStatus', 'toStatus', 'actorId', 'actorRole', 'occurredAt'])
          && request.resource.data.keys().hasAll(['fromStatus', 'toStatus', 'actorId', 'actorRole', 'occurredAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.fromStatus == get(/databases/$(database)/documents/bookings/$(bookingId)).data.status
          && request.resource.data.toStatus == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status
          && request.resource.data.occurredAt == request.time
          && eventId == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.latestTransitionId
          && (
            (request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.requesterId
              && request.resource.data.actorRole == 'requester')
            || (request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId
              && request.resource.data.actorRole == 'provider')
          );
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // A review is an immutable, booking-scoped trust signal. New reviews use
      // the booking ID as their document ID, making duplicate submission races
      // impossible and allowing rules to enforce one review per booking.
      allow create: if isAuthenticated()
        && reviewId == request.resource.data.bookingId
        && request.resource.data.keys().hasOnly([
          'bookingId', 'providerId', 'requesterId', 'serviceId', 'rating', 'comment',
          'images', 'responses', 'isHelpful', 'helpfulBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.providerId is string
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.serviceId is string
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && request.resource.data.responses is list
        && request.resource.data.responses.size() == 0
        && request.resource.data.isHelpful == 0
        && request.resource.data.helpfulBy is list
        && request.resource.data.helpfulBy.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.requesterId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.serviceId == request.resource.data.serviceId;

      // The requester may edit only their rating/comment/photos. Booking
      // ownership and the provider's response can never be changed by them.
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.requesterId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'images', 'updatedAt'])
          && request.resource.data.rating in [1, 2, 3, 4, 5]
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 5
          && request.resource.data.updatedAt == request.time
        )
        || (
          request.auth.uid == resource.data.providerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses', 'updatedAt'])
          && request.resource.data.responses is list
          && request.resource.data.responses.size() == 1
          && request.resource.data.responses[0].text is string
          && request.resource.data.responses[0].text.size() > 0
          && request.resource.data.responses[0].text.size() <= 500
          && request.resource.data.responses[0].date is timestamp
          && request.resource.data.updatedAt == request.time
        )
        || (
          request.auth.uid != resource.data.requesterId
          && request.auth.uid != resource.data.providerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHelpful', 'helpfulBy', 'updatedAt'])
          && request.resource.data.helpfulBy is list
          && request.resource.data.isHelpful == request.resource.data.helpfulBy.size()
          && request.resource.data.isHelpful >= 0
          && request.resource.data.isHelpful <= 1000
          && request.resource.data.updatedAt == request.time
        )
      );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.requesterId;
    }

    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if false;
    }

    // Retained for compatibility with existing data. Current app messages live
    // below conversations; this top-level collection should be removed later.
    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      // A chat is addressed by a deterministic ID. The client must be able to
      // check whether that document exists before creating it, but may only
      // read an existing conversation when it is one of its participants.
      allow get: if isAuthenticated()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantDetails == resource.data.participantDetails
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastRead', 'typing', 'updatedAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /earnings/{earningId} {
      allow read: if isOwner(resource.data.providerId);
    }

    match /referrals/{referralId} {
      allow read: if isOwner(resource.data.referrerId);
      allow create: if isAuthenticated() && request.resource.data.referrerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
