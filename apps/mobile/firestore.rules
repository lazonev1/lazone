rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBookingParticipant(booking) {
      return isAuthenticated()
        && (request.auth.uid == booking.requesterId || request.auth.uid == booking.providerId);
    }

    function hasNewLinkedBookingStatusEvent(bookingId) {
      return request.resource.data.latestTransitionId is string
        && (!resource.data.keys().hasAll(['latestTransitionId'])
          || request.resource.data.latestTransitionId != resource.data.latestTransitionId)
        && !exists(/databases/$(database)/documents/bookings/$(bookingId)/events/$(request.resource.data.latestTransitionId))
        && existsAfter(/databases/$(database)/documents/bookings/$(bookingId)/events/$(request.resource.data.latestTransitionId));
    }

    function hasValidConversationParticipantDetails(details, userId) {
      let profilePath = /databases/$(database)/documents/publicProfiles/$(userId);
      let profile = get(profilePath).data;
      return exists(profilePath)
        && details is map
        && details.keys().hasOnly(['name', 'avatar'])
        && details.keys().hasAll(['name', 'avatar'])
        && details.name == profile.firstName + ' ' + profile.lastName
        && details.avatar == profile.get('avatar', '');
    }

    function isValidConversationCreate(conversationId) {
      let participants = request.resource.data.participants;
      let details = request.resource.data.participantDetails;
      return request.resource.data.keys().hasOnly([
          'participants', 'participantDetails', 'createdAt', 'updatedAt', 'lastRead', 'typing'
        ])
        && request.resource.data.keys().hasAll([
          'participants', 'participantDetails', 'createdAt', 'updatedAt', 'lastRead', 'typing'
        ])
        && participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string
        && participants[0] != participants[1]
        && participants[0].size() > 0
        && participants[0].size() <= 128
        && participants[1].size() > 0
        && participants[1].size() <= 128
        && conversationId == (participants[0] < participants[1]
          ? participants[0] + '_' + participants[1]
          : participants[1] + '_' + participants[0])
        && request.auth.uid in participants
        && details is map
        && details.keys().hasOnly([participants[0], participants[1]])
        && details.keys().hasAll([participants[0], participants[1]])
        && hasValidConversationParticipantDetails(details[participants[0]], participants[0])
        && hasValidConversationParticipantDetails(details[participants[1]], participants[1])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastRead is map
        && request.resource.data.lastRead.size() == 0
        && request.resource.data.typing is map
        && request.resource.data.typing.size() == 0;
    }

    function isCallerReadStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRead'])
        && request.resource.data.lastRead is map
        && (
          (!resource.data.keys().hasAny(['lastRead'])
            && request.resource.data.lastRead.keys().hasOnly([request.auth.uid]))
          || (resource.data.keys().hasAny(['lastRead'])
            && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.lastRead.keys().hasAll([request.auth.uid])
        && request.resource.data.lastRead[request.auth.uid] == request.time;
    }

    function isCallerTypingStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typing'])
        && request.resource.data.typing is map
        && (
          (!resource.data.keys().hasAny(['typing'])
            && request.resource.data.typing.keys().hasOnly([request.auth.uid]))
          || (resource.data.keys().hasAny(['typing'])
            && request.resource.data.typing.diff(resource.data.typing).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.typing.keys().hasAll([request.auth.uid])
        && request.resource.data.typing[request.auth.uid] is bool;
    }

    function isLinkedMessageSummaryUpdate(conversationId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let messagePath = request.resource.data.lastMessage;
      return changedKeys.hasOnly(['lastMessage', 'lastRead', 'updatedAt'])
        && changedKeys.hasAll(['lastMessage', 'lastRead', 'updatedAt'])
        && request.resource.data.lastRead is map
        && (
          (!resource.data.keys().hasAny(['lastRead'])
            && request.resource.data.lastRead.keys().hasOnly([request.auth.uid]))
          || (resource.data.keys().hasAny(['lastRead'])
            && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.lastRead.keys().hasAll([request.auth.uid])
        && request.resource.data.lastRead[request.auth.uid] == request.time
        && request.resource.data.updatedAt == request.time
        && messagePath is path
        && (!resource.data.keys().hasAny(['lastMessage']) || messagePath != resource.data.lastMessage)
        && !exists(messagePath)
        && existsAfter(messagePath)
        && messagePath == /databases/$(database)/documents/conversations/$(conversationId)/messages/$(getAfter(messagePath).id)
        && getAfter(messagePath).data.conversationId == conversationId
        && getAfter(messagePath).data.senderId == request.auth.uid
        && getAfter(messagePath).data.createdAt == request.time;
    }

    function hasMatchingServiceDocument(providerId, services, index) {
      return services.size() <= index || (
        services[index] is map
        && services[index].keys().hasOnly(['id', 'name', 'description', 'price', 'availability'])
        && services[index].keys().hasAll(['id', 'name', 'description', 'price'])
        && existsAfter(/databases/$(database)/documents/providers/$(providerId)/services/$(services[index].id))
        && getAfter(/databases/$(database)/documents/providers/$(providerId)/services/$(services[index].id)).data == services[index]
      );
    }

    function hasPublishedServices(providerId, providerData) {
      let services = providerData.services;
      return providerData.keys().hasAll(['services'])
        && services is list
        && services.size() > 0
        && services.size() <= 5
        && hasMatchingServiceDocument(providerId, services, 0)
        && hasMatchingServiceDocument(providerId, services, 1)
        && hasMatchingServiceDocument(providerId, services, 2)
        && hasMatchingServiceDocument(providerId, services, 3)
        && hasMatchingServiceDocument(providerId, services, 4);
    }

    function hasServiceProjection(providerData) {
      return providerData.keys().hasAll(['services'])
        && providerData.services is list
        && providerData.services.size() > 0
        && providerData.services.size() <= 5;
    }

    function isValidProviderService(serviceId, data) {
      return data.keys().hasOnly(['id', 'name', 'description', 'price', 'availability'])
        && data.keys().hasAll(['id', 'name', 'description', 'price'])
        && data.id == serviceId
        && serviceId.size() > 0
        && serviceId.size() <= 128
        && serviceId.matches('^[A-Za-z0-9_-]+$')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.name.matches('.*[^ ].*')
        && data.description is string
        && data.description.size() <= 1000
        && data.price is string
        && data.price.matches('^[1-9][0-9]{0,8}$')
        && (!data.keys().hasAny(['availability'])
          || data.availability == null
          || (data.availability is string && data.availability.size() <= 200));
    }

    function isValidPendingChecklistItemAt(checklist, progress, index, expectedId) {
      return checklist.size() <= index || (
        checklist[index] is map
        && checklist[index].keys().hasOnly(['id', 'description', 'completed'])
        && checklist[index].keys().hasAll(['id', 'description', 'completed'])
        && checklist[index].id == expectedId
        && checklist[index].description is string
        && checklist[index].description.size() > 0
        && checklist[index].description.size() <= 300
        && checklist[index].description.matches('.*[^ ].*')
        && checklist[index].completed == false
        && progress[expectedId] == false
      );
    }

    function isValidPendingChecklist(data) {
      let checklist = data.checklist;
      let progress = data.checklistProgress;
      return checklist is list
        && checklist.size() > 0
        && checklist.size() <= 5
        && progress is map
        && progress.size() == checklist.size()
        && data.checklistTotal == checklist.size()
        && data.checklistCompletedCount == 0
        && isValidPendingChecklistItemAt(checklist, progress, 0, 'item-1')
        && isValidPendingChecklistItemAt(checklist, progress, 1, 'item-2')
        && isValidPendingChecklistItemAt(checklist, progress, 2, 'item-3')
        && isValidPendingChecklistItemAt(checklist, progress, 3, 'item-4')
        && isValidPendingChecklistItemAt(checklist, progress, 4, 'item-5');
    }

    function hasValidPendingBookingFields(data) {
      return data.serviceId is string
        && data.serviceId.size() > 0
        && data.serviceId.size() <= 128
        && data.serviceName is string
        && data.serviceName.size() > 0
        && data.serviceName.size() <= 120
        && data.bookingDate is timestamp
        && data.price is int
        && data.price > 0
        && data.price <= 999999999
        && (data.notes == null || (data.notes is string && data.notes.size() <= 2000))
        && data.updatedAt == request.time
        && isValidPendingChecklist(data);
    }

    function providerServiceMatches(providerId, serviceId, serviceName) {
      let providerPath = /databases/$(database)/documents/providers/$(providerId);
      let servicePath = /databases/$(database)/documents/providers/$(providerId)/services/$(serviceId);
      return exists(providerPath)
        && get(providerPath).data.publicSchemaVersion == 1
        && exists(servicePath)
        && get(servicePath).data.name == serviceName
        && get(servicePath).data in get(providerPath).data.services;
    }

    function isValidBookingCreate(data) {
      return data.keys().hasOnly([
          'requesterId', 'requesterName', 'providerId', 'providerName',
          'serviceId', 'serviceName', 'bookingDate', 'price', 'notes',
          'status', 'checklist', 'checklistTotal', 'checklistCompletedCount',
          'checklistProgress', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'requesterId', 'requesterName', 'providerId', 'providerName',
          'serviceId', 'serviceName', 'bookingDate', 'price', 'notes',
          'status', 'checklist', 'checklistTotal', 'checklistCompletedCount',
          'checklistProgress', 'createdAt', 'updatedAt'
        ])
        && data.requesterId == request.auth.uid
        && data.providerId is string
        && data.providerId != request.auth.uid
        && data.requesterName is string
        && data.requesterName.size() > 0
        && data.requesterName.size() <= 160
        && data.providerName is string
        && data.providerName.size() > 0
        && data.providerName.size() <= 160
        && data.status == 'pending'
        && data.bookingDate >= request.time + duration.value(5, 'm')
        && data.bookingDate <= request.time + duration.value(365, 'd')
        && data.createdAt == request.time
        && hasValidPendingBookingFields(data)
        && providerServiceMatches(data.providerId, data.serviceId, data.serviceName);
    }

    function isRatingAggregateUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'averageRating', 'reviewCount', 'updatedAt'
        ])
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0;
    }

    function isPublicIdentity(data) {
      return data.keys().hasOnly(['firstName', 'lastName', 'avatar', 'updatedAt'])
        && data.keys().hasAll(['firstName', 'lastName'])
        && data.firstName is string
        && data.lastName is string
        && data.firstName.size() <= 80
        && data.lastName.size() <= 80
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048));
    }

    function isPublicProvider(data) {
      return data.keys().hasOnly([
        'firstName', 'lastName', 'avatar', 'businessName', 'profession',
        'categoryName', 'bio', 'remoteService', 'services', 'reviews',
        'averageRating', 'reviewCount', 'coverImage', 'portfolio',
        'pricing', 'location', 'createdAt', 'updatedAt', 'publicSchemaVersion'
      ])
        && data.publicSchemaVersion == 1
        && (!data.keys().hasAny(['location']) || (
          data.location is map
          && data.location.keys().hasOnly(['country', 'city', 'coordinates'])
          && data.location.country is string
          && data.location.city is string
          && (!data.location.keys().hasAny(['coordinates']) || (
            data.location.coordinates is map
            && data.location.coordinates.keys().hasOnly(['latitude', 'longitude'])
            && data.location.coordinates.latitude is number
            && data.location.coordinates.longitude is number
          ))
        ));
    }

    function isValidAccountCreate(data) {
      return data.keys().hasOnly([
          'firstName', 'lastName', 'phoneNumber', 'dob', 'role', 'avatar',
          'verified', 'subscriptionType', 'bookmarked', 'location',
          'notificationTokens', 'preferences', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'firstName', 'lastName', 'phoneNumber', 'role', 'verified',
          'subscriptionType', 'bookmarked', 'createdAt', 'updatedAt'
        ])
        && data.firstName is string
        && data.firstName.size() <= 80
        && data.lastName is string
        && data.lastName.size() <= 80
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 32
        && data.role == 'requester'
        && data.verified == false
        && data.subscriptionType == 'free'
        && data.bookmarked is list
        && data.bookmarked.size() <= 500
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['dob']) || data.dob is timestamp)
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048))
        && (!data.keys().hasAny(['location']) || data.location is map)
        && (!data.keys().hasAny(['notificationTokens']) || (
          data.notificationTokens is list && data.notificationTokens.size() <= 20
        ))
        && (!data.keys().hasAny(['preferences']) || data.preferences is map);
    }

    function hasValidEditableAccountFields(data) {
      return (!data.keys().hasAny(['firstName']) || (data.firstName is string && data.firstName.size() <= 80))
        && (!data.keys().hasAny(['lastName']) || (data.lastName is string && data.lastName.size() <= 80))
        && (!data.keys().hasAny(['phoneNumber']) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && (!data.keys().hasAny(['dob']) || data.dob is timestamp)
        && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048))
        && (!data.keys().hasAny(['bookmarked']) || (
          data.bookmarked is list && data.bookmarked.size() <= 500
        ))
        && (!data.keys().hasAny(['location']) || data.location is map)
        && (!data.keys().hasAny(['notificationTokens']) || (
          data.notificationTokens is list && data.notificationTokens.size() <= 20
        ))
        && (!data.keys().hasAny(['preferences']) || data.preferences is map);
    }

    function isSelfServiceAccountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'phoneNumber', 'dob', 'avatar', 'bookmarked',
          'location', 'notificationTokens', 'preferences', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasValidEditableAccountFields(request.resource.data);
    }

    function isProviderRolePromotion(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && resource.data.role == 'requester'
        && request.resource.data.role == 'both'
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/providers/$(userId))
        && getAfter(/databases/$(database)/documents/providers/$(userId)).data.publicSchemaVersion == 1
        && hasServiceProjection(getAfter(/databases/$(database)/documents/providers/$(userId)).data);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAccountCreate(request.resource.data);
      allow update: if isOwner(userId)
        && (isSelfServiceAccountUpdate() || isProviderRolePromotion(userId));
      // Account deletion needs coordinated Auth/data cleanup (A03), not a
      // client-side document delete that leaves bookings and messages orphaned.
      allow delete: if false;
    }

    // Minimal identity used by chat and reviews. A caller may fetch a known
    // identity (for example, the author referenced by a public review), but
    // requesters are not a browsable directory.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner(userId) && isPublicIdentity(request.resource.data);
      allow delete: if false;
    }

    // TODO(security): restrict updates to isOwner(providerId) once provider
    // ratings are aggregated by trusted backend code. The current review flow
    // recalculates rating fields on the reviewer's device, which needs this
    // temporary development exception.
    match /providers/{providerId} {
      // Owners may inspect their own record, including checking for its absence
      // before enrollment. Other readers and list queries see migrated profiles.
      allow get: if isOwner(providerId) || resource.data.publicSchemaVersion == 1;
      allow list: if resource.data.publicSchemaVersion == 1;
      allow create: if isOwner(providerId) && hasPublishedServices(providerId, request.resource.data)
        && isPublicProvider(request.resource.data)
        && existsAfter(/databases/$(database)/documents/users/$(providerId))
        && getAfter(/databases/$(database)/documents/users/$(providerId)).data.role in ['provider', 'both'];
      allow delete: if isOwner(providerId);
      allow update: if isAuthenticated()
        && hasPublishedServices(providerId, request.resource.data)
        && isPublicProvider(request.resource.data)
        && (isOwner(providerId) || isRatingAggregateUpdate());

      match /services/{serviceId} {
        allow read: if exists(/databases/$(database)/documents/providers/$(providerId))
          && get(/databases/$(database)/documents/providers/$(providerId)).data.publicSchemaVersion == 1;
        allow create, update: if isOwner(providerId)
          && isValidProviderService(serviceId, request.resource.data)
          && request.resource.data in getAfter(/databases/$(database)/documents/providers/$(providerId)).data.services;
        allow delete: if isOwner(providerId)
          && !(resource.data in getAfter(/databases/$(database)/documents/providers/$(providerId)).data.services);
      }
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isBookingParticipant(resource.data);
      allow create: if isAuthenticated() && isValidBookingCreate(request.resource.data);
      allow update: if isBookingParticipant(resource.data)
        && (
          (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'serviceId', 'serviceName', 'bookingDate', 'price', 'notes', 'checklist', 'checklistTotal', 'checklistCompletedCount', 'checklistProgress', 'updatedAt'
            ])
            && hasValidPendingBookingFields(request.resource.data)
            && (request.resource.data.bookingDate == resource.data.bookingDate
              || (request.resource.data.bookingDate >= request.time + duration.value(5, 'm')
                && request.resource.data.bookingDate <= request.time + duration.value(365, 'd')))
            && providerServiceMatches(resource.data.providerId, request.resource.data.serviceId, request.resource.data.serviceName)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'in_progress'
            && request.resource.data.status == resource.data.status
            && request.resource.data.keys().hasAll(['checklistProgress', 'checklistCompletedCount'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklistProgress', 'checklistCompletedCount', 'updatedAt'])
            && request.resource.data.checklistProgress is map
            && request.resource.data.checklistCompletedCount >= 0
            && request.resource.data.checklistCompletedCount <= resource.data.checklistTotal
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['confirmed', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.providerId
            && resource.data.status == 'in_progress'
            && request.resource.data.status == 'awaiting_confirmation'
            && request.resource.data.keys().hasAll(['requesterChangeRequest'])
            && request.resource.data.requesterChangeRequest == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requesterChangeRequest', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'awaiting_confirmation'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
          || (
            request.auth.uid == resource.data.requesterId
            && resource.data.status == 'awaiting_confirmation'
            && request.resource.data.status == 'in_progress'
            && request.resource.data.keys().hasAll(['requesterChangeRequest'])
            && request.resource.data.requesterChangeRequest is string
            && request.resource.data.requesterChangeRequest.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requesterChangeRequest', 'updatedAt', 'latestTransitionId'])
            && hasNewLinkedBookingStatusEvent(bookingId)
          )
        );
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isBookingParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data);
        allow create: if isBookingParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
          && request.resource.data.keys().hasOnly(['fromStatus', 'toStatus', 'actorId', 'actorRole', 'occurredAt'])
          && request.resource.data.keys().hasAll(['fromStatus', 'toStatus', 'actorId', 'actorRole', 'occurredAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.fromStatus == get(/databases/$(database)/documents/bookings/$(bookingId)).data.status
          && request.resource.data.toStatus == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status
          && request.resource.data.occurredAt == request.time
          && eventId == getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.latestTransitionId
          && (
            (request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.requesterId
              && request.resource.data.actorRole == 'requester')
            || (request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId
              && request.resource.data.actorRole == 'provider')
          );
        allow update, delete: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // A review is an immutable, booking-scoped trust signal. New reviews use
      // the booking ID as their document ID, making duplicate submission races
      // impossible and allowing rules to enforce one review per booking.
      allow create: if isAuthenticated()
        && reviewId == request.resource.data.bookingId
        && request.resource.data.keys().hasOnly([
          'bookingId', 'providerId', 'requesterId', 'serviceId', 'rating', 'comment',
          'images', 'responses', 'isHelpful', 'helpfulBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.providerId is string
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.serviceId is string
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && request.resource.data.responses is list
        && request.resource.data.responses.size() == 0
        && request.resource.data.isHelpful == 0
        && request.resource.data.helpfulBy is list
        && request.resource.data.helpfulBy.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.requesterId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.serviceId == request.resource.data.serviceId;

      // The requester may edit only their rating/comment/photos. Booking
      // ownership and the provider's response can never be changed by them.
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.requesterId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'images', 'updatedAt'])
          && request.resource.data.rating in [1, 2, 3, 4, 5]
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 500
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 5
          && request.resource.data.updatedAt == request.time
        )
        || (
          request.auth.uid == resource.data.providerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses', 'updatedAt'])
          && request.resource.data.responses is list
          && request.resource.data.responses.size() == 1
          && request.resource.data.responses[0].text is string
          && request.resource.data.responses[0].text.size() > 0
          && request.resource.data.responses[0].text.size() <= 500
          && request.resource.data.responses[0].date is timestamp
          && request.resource.data.updatedAt == request.time
        )
        || (
          request.auth.uid != resource.data.requesterId
          && request.auth.uid != resource.data.providerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHelpful', 'helpfulBy', 'updatedAt'])
          && request.resource.data.helpfulBy is list
          && request.resource.data.isHelpful == request.resource.data.helpfulBy.size()
          && request.resource.data.isHelpful >= 0
          && request.resource.data.isHelpful <= 1000
          && request.resource.data.updatedAt == request.time
        )
      );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.requesterId;
    }

    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if false;
    }

    // Retained for compatibility with existing data. Current app messages live
    // below conversations; this top-level collection should be removed later.
    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      // A chat is addressed by a deterministic ID. The client must be able to
      // check whether that document exists before creating it, but may only
      // read an existing conversation when it is one of its participants.
      allow get: if isAuthenticated()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && isValidConversationCreate(conversationId);
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantDetails == resource.data.participantDetails
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          isCallerReadStatusUpdate()
          || isCallerTypingStatusUpdate()
          || isLinkedMessageSummaryUpdate(conversationId)
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['conversationId', 'senderId', 'text', 'createdAt'])
          && request.resource.data.conversationId == conversationId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessage
            == /databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId);
        allow update, delete: if false;
      }
    }

    match /earnings/{earningId} {
      allow read: if isOwner(resource.data.providerId);
    }

    match /referrals/{referralId} {
      allow read: if isOwner(resource.data.referrerId);
      allow create: if isAuthenticated() && request.resource.data.referrerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
