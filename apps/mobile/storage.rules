rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Review-image uploads are disabled in the app until reviews have a
    // server-verified upload flow. Do not leave an unauthorised write path open.
    match /reviews/{reviewId}/{allPaths=**} {
      allow read: if true; // Anyone can view review images
      allow write: if false;
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Provider images (portfolio, cover, etc.)
    match /providers/{providerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == providerId;
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
